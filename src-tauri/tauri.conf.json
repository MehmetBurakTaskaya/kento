{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kento",
  "version": "0.1.0",
  "identifier": "com.mehmetburaktaskaya.kento",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "wheel",
        "title": "Kento",
        "url": "index.html?surface=wheel",
        "width": 520,
        "height": 520,
        "x": -20000,
        "y": -20000,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": true,
        "dragDropEnabled": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Mehmet Burak Taşkaya",
    "publisher": "Mehmet Burak Taşkaya",
    "homepage": "https://github.com/MehmetBurakTaskaya/kento",
    "license": "MIT",
    "shortDescription": "Drop a file on the wheel to convert it",
    "longDescription": "Drag a file, press a modifier key and drop it on a slice of the wheel: Kento converts, compresses and edits files on your own computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/pdfium/": "pdfium/"
    }
  }
}
