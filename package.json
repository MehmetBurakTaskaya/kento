{
  "name": "kento",
  "private": true,
  "version": "0.1.0",
  "description": "Drag a file, press a modifier key, drop it on the wheel: local file conversion and tools for Windows and macOS.",
  "author": "Mehmet Burak Taşkaya",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts \"*.js\" \"*.ts\"",
    "format": "prettier --write src scripts locales .github index.html \"*.json\" \"*.js\" \"*.ts\"",
    "format:check": "prettier --check src scripts locales .github index.html \"*.json\" \"*.js\" \"*.ts\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:licenses": "node scripts/check-npm-licenses.mjs",
    "catalog:export": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin catalog-export",
    "icons": "node scripts/icons.mjs",
    "pdfium": "node scripts/fetch-pdfium.mjs",
    "shots": "node scripts/shoot-app.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.6.0",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/sofia-sans": "5.3.0",
    "@fontsource-variable/sofia-sans-condensed": "5.3.0",
    "@fontsource-variable/tektur": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource-variable/vollkorn": "5.3.0",
    "@fontsource-variable/ysabeau": "5.3.0",
    "@fontsource-variable/ysabeau-office": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
